# Copy to .env — local inference overrides

# FastAPI server (server.py / server_gemma4.py)
BONSAI_HOST=127.0.0.1
BONSAI_PORT=8080

# Proxy for axon / vault (bonsai_proxy.py in neuruh-vault)
BONSAI_PROXY_HOST=127.0.0.1
BONSAI_PROXY_PORT=8100
OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate
BONSAI_PROXY_MODEL=llama3:latest

# Gemma4 MLX server (when using server_gemma4.py)
# GEMMA4_MODEL_PATH=/path/to/mlx-weights
